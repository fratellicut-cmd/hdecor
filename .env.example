# Variables d'environnement de H'DECOR. AUCUNE valeur ici : les valeurs réelles
# se saisissent dans Vercel (Production / Preview) ou, en local, sont écrites
# par scripts/supabase-sans-docker/demarrer.sh dans .env.local (non versionné).

# Publiques (exposées au navigateur) : n'ouvrent que ce que la RLS autorise.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# SECRÈTES (serveur uniquement, jamais préfixées NEXT_PUBLIC_).
# Clé « service_role » : contourne la RLS (fichiers, tâche planifiée).
SUPABASE_SERVICE_ROLE_KEY=
# Secret de la tâche planifiée /api/cron/conservation (32 caractères minimum,
# par exemple : openssl rand -hex 32). Vercel l'envoie en « Authorization: Bearer ».
CRON_SECRET=

# Envoi des emails (devis, relances) par Resend. Sans ces deux valeurs, aucun
# email n'est envoyé : l'application propose de partager le lien à la main.
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, par exemple : H'DECOR <devis@votre-domaine.fr>
EMAIL_EXPEDITEUR=
